#include <iostream>
#include <stdlib.h>
#include <string.h>
using namespace std;

class Ser{
private:
	string nombre;
	int max_hp;
	int hp;
	int max_eng;
	int energia;
	int atk;
	bool vivo;
	
public:
	//Constructor por defecto
    Ser(){ 
		nombre="Nadie"; max_hp=50; hp=50; max_eng=30; energia=30; atk=10; vivo=true;
	}
	
	//Constructor por parametros
	Ser(string n, int maxh, int h, int maxe, int e, int a, bool v){ 
		nombre=n;
		max_hp=maxh;
		hp=h;
		max_eng=maxe;
		energia=e;
		atk=a;
		vivo=v;
	}
	
	//Destructor
    ~Ser(){ 
	}

    //Setter
	void setNombre(string n){
	nombre = n;
}
	
	//Getters
	string getNombre() const { return nombre;}
	
	//FUNCIONES
	
	//Mirar datos
	void mostrar(){
	string estado;
	 if(vivo=true){
	 estado = "Con vida";
	 }else estado = "Muerto";
	cout << " | Nombre: " << nombre << " | Vida: " << max_hp << "/" << hp << " | Estamina: " << max_eng << "/" << energia << " | Ataque : " << atk << " | Estado: " << estado << endl;
	cout << endl;
	}
	
    //atacar
	void atacar(Ser& obj){ 
 	     int vida;
 	     vida = obj.hp - atk; 
 	     obj.hp = vida;
 	     if(obj.hp<=0){obj.hp=0;}
 	     cout << obj.nombre << " recibio " << atk << " puntos de danio por parte de " << nombre << endl;
		}
	
	// descansar	
	void rest(){ 
		int tiempo;
		    cout << "¿Por cuantos minutos descansa " << nombre << "?" << endl;
		    cin >> tiempo;
		    energia = energia + (tiempo*2);
		    if (energia > max_eng){energia = max_eng;}
		} 
	
	// perder energia	
	void correr(){ 
		int tiempo;
		
		    cout << "¿Por cuanto tiempo corre " << nombre << "?" << endl;
			cin >> tiempo;
			
			energia = energia - (tiempo*2);
			if (energia<0){energia=0;}
		} 
	
};	

